<Application x:Class="Ps5Altyazi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Altyazı+ renkleri -->
        <Color x:Key="AccentA">#6C5CFC</Color>
        <Color x:Key="AccentB">#EC487A</Color>
        <SolidColorBrush x:Key="Bg" Color="#14161B"/>
        <SolidColorBrush x:Key="Card" Color="#1E2128"/>
        <SolidColorBrush x:Key="CardAlt" Color="#262A33"/>
        <SolidColorBrush x:Key="Line" Color="#2F3440"/>
        <SolidColorBrush x:Key="TextMain" Color="#ECEEF3"/>
        <SolidColorBrush x:Key="TextDim" Color="#9AA1AE"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C5CFC" Offset="0"/>
            <GradientStop Color="#EC487A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Düğme: yuvarlak köşeli koyu düğme, üstüne gelince açılır -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="Background" Value="#2A2F3A"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#363C4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6C5CFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20242C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ana düğme (Başlat): marka renk geçişi -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="CaretBrush" Value="#ECEEF3"/>
            <Setter Property="SelectionBrush" Value="#6C5CFC"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="CaretBrush" Value="#ECEEF3"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#8AB4FF"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
        </Style>

        <!-- Kart: koyu, yuvarlak köşeli kutu -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E2128"/>
            <Setter Property="BorderBrush" Value="#2F3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA1AE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,10,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA1AE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEEF3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Application.Resources>
</Application>
