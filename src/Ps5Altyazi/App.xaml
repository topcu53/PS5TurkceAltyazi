<Application x:Class="Ps5Altyazi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ═══ Altyazı+ renkleri (logodan: gece laciverti, elektrik mavisi, camgöbeği) ═══ -->
        <SolidColorBrush x:Key="Bg" Color="#0B0F1A"/>
        <SolidColorBrush x:Key="Card" Color="#121826"/>
        <SolidColorBrush x:Key="CardAlt" Color="#182033"/>
        <SolidColorBrush x:Key="Line" Color="#222C42"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8EDF7"/>
        <SolidColorBrush x:Key="TextDim" Color="#8B97AD"/>
        <SolidColorBrush x:Key="Accent" Color="#2F8BFF"/>
        <SolidColorBrush x:Key="Cyan" Color="#33C6FF"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E5BFF" Offset="0"/>
            <GradientStop Color="#22B4F5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LiveCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1846D8" Offset="0"/>
            <GradientStop Color="#0E7CC4" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
        <DropShadowEffect x:Key="Glow" BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#2F8BFF"/>

        <!-- ═══ Düğme ═══ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Background" Value="#182033"/>
            <Setter Property="BorderBrush" Value="#26324A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2A42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F8BFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141B2B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ana düğme (Başlat): mavi → camgöbeği, parlama -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Effect" Value="{StaticResource Glow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Aç/kapa anahtarı (CheckBox) ═══ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" Background="#26324A" BorderBrush="#33415E" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#C9D2E3" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2F8BFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2F8BFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Seçenek düğmesi (RadioButton) ═══ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="#3A4766" StrokeThickness="2" Fill="#121826"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#33C6FF" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#2F8BFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#2F8BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Açılır liste (ComboBox) ═══ -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="#182033" BorderBrush="#26324A" BorderThickness="1" CornerRadius="10">
                <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" Stroke="#8B97AD" StrokeThickness="1.6"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2F8BFF"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#33C6FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="#121826" BorderBrush="#2F8BFF" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2A42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E5BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Katlanır bölüm (Expander) ═══ -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Path x:Name="Chev" Data="M0,0 L4,4 L0,8" Stroke="#33C6FF" StrokeThickness="1.8"
                                                  VerticalAlignment="Center" Margin="2,0,10,0" RenderTransformOrigin="0.5,0.5"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chev" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                           Foreground="#8B97AD" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ İnce kaydırma çubuğu ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#2A3650" Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="4" Background="#2A3650" Margin="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Yazı kutuları, bağlantılar, ipuçları ═══ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F1422"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#26324A"/>
            <Setter Property="CaretBrush" Value="#33C6FF"/>
            <Setter Property="SelectionBrush" Value="#1E5BFF"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F1422"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#26324A"/>
            <Setter Property="CaretBrush" Value="#33C6FF"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#5DB8FF"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#182033"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#2F8BFF"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- ═══ Kart ve yazı stilleri ═══ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#121826"/>
            <Setter Property="BorderBrush" Value="#1D2639"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#33C6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,10,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B97AD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Application.Resources>
</Application>
