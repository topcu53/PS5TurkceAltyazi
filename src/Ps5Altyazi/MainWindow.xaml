<Window x:Class="Ps5Altyazi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı+ – PS5 oyunları için canlı Türkçe altyazı"
        Icon="Resources/logo-256.png"
        Height="900" Width="1300" MinHeight="500" MinWidth="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Grid x:Name="MainGrid" Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Üst bant: logo, ad, durum, Başlat ═════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderLogo" Source="Resources/logo-256.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="Bold">
                    <Run Text="Altyazı"/><Run Text="+" Foreground="#33C6FF"/>
                </TextBlock>
                <TextBlock x:Name="HeaderSub" Foreground="{StaticResource TextDim}" FontSize="13"
                           Text="PS5 oyunları için canlı Türkçe altyazı  •  Yapımcı: Burak Topcu"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#33C6FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CaptureStatus" Text="Durduruldu" FontSize="13" VerticalAlignment="Center"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button x:Name="StartStopButton" Style="{StaticResource Primary}" Content="▶ Başlat (F6)" Click="StartStop_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═════════ Kaynak ve altyazı ayarları ═════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="KAYNAK"/>
                    <ComboBox x:Name="WindowCombo" Width="360"/>
                    <Button Content="⟳ Yenile" Click="Refresh_Click" ToolTip="Pencere listesini yenile"/>
                    <Button Content="🔍 Remote Play'i Bul" Click="FindRemotePlay_Click"/>
                    <Button x:Name="LaunchRemotePlayButton" Content="▶ PS Remote Play'i Aç" Click="LaunchRemotePlay_Click"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource Line}" Margin="10,0"/>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ALTYAZI"/>
                    <CheckBox x:Name="SubtitleWindowCheck" IsChecked="True" FontWeight="Bold" Content="Türkçe altyazı (F8)"
                              Checked="SubtitleWindowCheck_Changed" Unchecked="SubtitleWindowCheck_Changed"/>
                    <CheckBox x:Name="OcrCheck" IsChecked="True" Content="Okuma" ToolTip="Altyazı alanındaki İngilizce yazıyı okur (OCR)"
                              Checked="OcrCheck_Changed" Unchecked="OcrCheck_Changed"/>
                    <CheckBox x:Name="TranslateCheck" IsChecked="True" Content="Çeviri"
                              Checked="TranslateCheck_Changed" Unchecked="TranslateCheck_Changed"/>
                    <Button Content="🎨 Altyazı Görünümü" Click="SubtitleAppearance_Click"/>
                    <Button Content="🌐 Çeviri Ayarları" Click="TranslationSettings_Click"/>
                    <Button Content="📺 TV Modu" FontWeight="Bold" Click="TvMode_Click"/>
                    <CheckBox x:Name="TvServerCheck" Content="TV / telefon yayını"
                              Checked="TvServerCheck_Changed" Unchecked="TvServerCheck_Changed"/>
                    <!-- Oyun içi yazı çevirisi şimdilik rafta (kod duruyor, arayüzde gizli) -->
                    <CheckBox x:Name="ScreenCheck" Visibility="Collapsed" Checked="ScreenCheck_Changed" Unchecked="ScreenCheck_Changed"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═════════ Altyazı alanı ═════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitle}" Text="ALTYAZI ALANI"/>
                <Button x:Name="AutoDetectButton" Content="✦ Otomatik Bul" Click="AutoDetect_Click"/>
                <Button x:Name="SelectRegionButton" Content="▭ Fareyle Seç" Click="SelectRegion_Click"/>
                <Button Content="✕ Temizle" Click="ClearRegion_Click"/>
                <TextBlock x:Name="RegionText" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"
                           Margin="10,0,0,0" Text="Seçilmedi" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                <Button x:Name="InstallOcrButton" Content="İngilizce OCR Paketini Kur" Click="InstallOcr_Click"
                        Visibility="Collapsed" FontWeight="Bold"/>
                <TextBlock x:Name="SelectHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FFB03B"
                           Visibility="Collapsed" Text="Önizlemede altyazı alanını fareyle çizin. Vazgeçmek için Esc."/>
            </WrapPanel>
        </Border>

        <!-- ═════════ Önizleme + canlı çeviri ═════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                    <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged" ClipToBounds="True" Margin="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality"/>
                        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Image Source="Resources/logo-256.png" Width="72" Height="72" Opacity="0.85" Margin="0,0,0,14"/>
                            <TextBlock x:Name="PreviewPlaceholder" Foreground="{StaticResource TextDim}" FontSize="16" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="520"
                                       Text="Oyun görüntüsü burada görünecek.&#x0a;PS Remote Play'i açıp PS5'e bağlanın, sonra ▶ Başlat'a basın."/>
                        </StackPanel>
                        <Canvas x:Name="Overlay" Background="Transparent"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp">
                            <Canvas x:Name="LinesLayer" IsHitTestVisible="False"/>
                            <Rectangle x:Name="RegionRect" Stroke="#33C6FF" StrokeThickness="2" StrokeDashArray="4 2"
                                       Fill="#2233C6FF" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Rectangle x:Name="DragRect" Stroke="#2F8BFF" StrokeThickness="2"
                                       Fill="#222F8BFF" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Teşhis ve gelişmiş ayarlar (kapalı başlar) -->
                <Expander Grid.Row="1" Margin="0,10,0,0" Header="Gelişmiş ve teşhis" IsExpanded="False">
                    <Border Style="{StaticResource CardBorder}" Margin="0,6,0,0" Padding="10">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="YAKALAMA"/>
                                <ComboBox x:Name="MethodCombo" Width="250" SelectedIndex="0" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Windows Graphics Capture (önerilen)"/>
                                    <ComboBoxItem Content="PrintWindow (yedek / teşhis)"/>
                                </ComboBox>
                                <TextBlock Text="FPS" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                <ComboBox x:Name="FpsCombo" Width="60" SelectedIndex="2" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="60"/>
                                </ComboBox>
                                <CheckBox x:Name="CropCheck" IsChecked="True" Content="Başlık çubuğunu ve siyah bantları kırp"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="ARAÇLAR"/>
                                <Button x:Name="VerifyButton" Content="✔ 10 sn Doğrulama Testi" Click="Verify_Click"/>
                                <Button Content="Kare Kaydet (F9)" Click="SavePng_Click"/>
                                <Button Content="Görüntü Dosyasıyla Test Et…" Click="TestImage_Click"/>
                                <Button Content="📁 Log / Görüntü Klasörü" Click="OpenFolder_Click"/>
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource Label}" Margin="0" Text="ALTYAZI ALANI (CANLI, BÜYÜTÜLMÜŞ)"/>
                                    <Border Background="Black" Height="90" Margin="0,4,0,0" CornerRadius="6">
                                        <Image x:Name="RegionImage" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource Label}" Margin="0" Text="METİN MASKESİ (OCR'IN GÖRDÜĞÜ)"/>
                                    <Border Background="Black" Height="90" Margin="0,4,0,0" CornerRadius="6">
                                        <Image x:Name="MaskImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
            </Grid>

            <!-- Sağ panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Canlı çeviri kartı -->
                <Border Grid.Row="0" CornerRadius="12" Padding="18" Margin="0,0,0,10" Background="{StaticResource LiveCardBrush}">
                    <StackPanel>
                        <TextBlock Text="CANLI ÇEVİRİ" FontSize="11" FontWeight="Bold" Foreground="#E6FFFFFF"/>
                        <TextBlock x:Name="TurkishText" Text="—" FontSize="21" FontWeight="Bold" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PresenceText" Text="—" FontSize="13" Foreground="#DDFFFFFF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TranslationStatusText" Text="Başlatılıyor…" FontSize="11" Foreground="#CCFFFFFF"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Durum kartı -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="REMOTE PLAY" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RemotePlayStatus" Style="{StaticResource Value}" Text="Kontrol ediliyor…"/>

                            <TextBlock Style="{StaticResource Label}" Text="OKUMA (OCR)"/>
                            <TextBlock x:Name="OcrStatusText" Style="{StaticResource Value}" FontSize="12" Text="Başlatılıyor…"/>

                            <TextBlock Style="{StaticResource Label}" Text="GÖRÜNTÜ"/>
                            <TextBlock x:Name="VerdictText" Style="{StaticResource Value}" FontWeight="Bold" Text="—"/>

                            <Expander Header="Teknik ayrıntılar" Margin="0,12,0,0" IsExpanded="False">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="İNGİLİZCE METİN (TEST EKRANI)"/>
                                    <TextBlock x:Name="EnglishText" Style="{StaticResource Value}" FontSize="13" Text="—"/>
                                    <TextBlock Style="{StaticResource Label}" Text="OYUN ALANI / YÖNTEM"/>
                                    <TextBlock x:Name="FrameSizeText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                    <TextBlock Style="{StaticResource Label}" Text="FPS / İŞLEME SÜRESİ"/>
                                    <TextBlock x:Name="FpsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                    <TextBlock Style="{StaticResource Label}" Text="PARLAKLIK / KONTRAST / HAREKET"/>
                                    <TextBlock x:Name="LumaText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                    <TextBlock Style="{StaticResource Label}" Text="İSTATİSTİK (BU OTURUM)"/>
                                    <TextBlock x:Name="StatsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                    <TextBlock Style="{StaticResource Label}" Text="DOĞRULAMA TESTİ"/>
                                    <TextBlock x:Name="VerifyText" Style="{StaticResource Value}" FontSize="12"
                                               Text="Oyunda hareketli bir sahnedeyken '10 sn Doğrulama Testi'ne basın."/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ═════════ Günlük ═════════ -->
        <Expander Grid.Row="4" Header="Günlük (log)" Margin="0,10,0,0" IsExpanded="True">
            <ListBox x:Name="LogList" Height="130" Margin="0,6,0,0"
                     Background="#070A12" Foreground="#AFC0DA" BorderBrush="{StaticResource Line}"
                     FontFamily="Consolas" FontSize="12"/>
        </Expander>
    </Grid>
</Window>
