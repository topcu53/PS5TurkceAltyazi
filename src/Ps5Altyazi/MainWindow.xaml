<Window x:Class="Ps5Altyazi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı+ – PS5 oyunları için canlı Türkçe çeviri  •  Burak Topcu"
        Height="900" Width="1280" MinHeight="650" MinWidth="980"
        Background="#1B1D21" Foreground="#EEEEEE"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Satır 1: pencere ve yakalama ayarları -->
        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Pencere:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="WindowCombo" Width="440"/>
            <Button Content="Listeyi Yenile" Click="Refresh_Click"/>
            <Button Content="Remote Play'i Otomatik Bul" Click="FindRemotePlay_Click"/>
            <Button x:Name="LaunchRemotePlayButton" Content="PS Remote Play'i Aç" Click="LaunchRemotePlay_Click"/>
            <TextBlock Text="Yöntem:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="MethodCombo" Width="250" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="Windows Graphics Capture (önerilen)"/>
                <ComboBoxItem Content="PrintWindow (yedek / teşhis)"/>
            </ComboBox>
            <TextBlock Text="Hedef FPS:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="FpsCombo" Width="60" SelectedIndex="2" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="60"/>
            </ComboBox>
        </WrapPanel>

        <!-- Satır 2: yakalama eylemleri -->
        <WrapPanel Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center">
            <Button x:Name="StartStopButton" Content="▶ Başlat (F6)" FontWeight="Bold" Click="StartStop_Click"/>
            <Button x:Name="VerifyButton" Content="✔ 10 sn Doğrulama Testi" Click="Verify_Click"/>
            <Button Content="Kareyi PNG Kaydet" Click="SavePng_Click"/>
            <Button Content="Log / Görüntü Klasörünü Aç" Click="OpenFolder_Click"/>
            <CheckBox x:Name="SubtitleWindowCheck" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EEEEEE"
                      FontWeight="Bold" Content="Türkçe altyazı (F8)" Checked="SubtitleWindowCheck_Changed" Unchecked="SubtitleWindowCheck_Changed"/>
            <CheckBox x:Name="ScreenCheck" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EEEEEE" FontWeight="Bold"
                      Content="Tuş ipuçlarını sürekli çevir (deneysel) – ekranı bir kez çevirmek için F7" Checked="ScreenCheck_Changed" Unchecked="ScreenCheck_Changed"
                      ToolTip="Oynanış ekranındaki tuş ipuçlarını (Greet, Press X to …), görev ve ipucu yazılarını Türkçeye çevirir. Menüler çevrilmez; tuş simgeleri örtülmez."/>
            <Button Content="Altyazı Görünümü…" Click="SubtitleAppearance_Click"/>
            <Button Content="📺 TV Modu…" FontWeight="Bold" Click="TvMode_Click"/>
            <CheckBox x:Name="TvServerCheck" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#EEEEEE"
                      Content="TV / telefon yayını" Checked="TvServerCheck_Changed" Unchecked="TvServerCheck_Changed"/>
            <CheckBox x:Name="CropCheck" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EEEEEE"
                      Content="Başlık çubuğunu ve siyah bantları kırp (yalnızca 16:9 oyun alanı)"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
        </WrapPanel>

        <!-- Satır 3: altyazı alanı eylemleri -->
        <Border Grid.Row="2" Margin="0,6,0,6" Padding="6,2" Background="#262A31" CornerRadius="4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="ALTYAZI ALANI:" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Button x:Name="SelectRegionButton" Content="▭ Elle Seç (fareyle çiz)" Click="SelectRegion_Click"/>
                <Button x:Name="AutoDetectButton" Content="✦ Otomatik Bul" Click="AutoDetect_Click"/>
                <Button Content="Alanı Temizle" Click="ClearRegion_Click"/>
                <Button Content="Görüntü Dosyasıyla Test Et…" Click="TestImage_Click"/>
                <CheckBox x:Name="OcrCheck" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EEEEEE"
                          Content="OCR açık" Checked="OcrCheck_Changed" Unchecked="OcrCheck_Changed"/>
                <CheckBox x:Name="TranslateCheck" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#EEEEEE"
                          Content="Çeviri açık" Checked="TranslateCheck_Changed" Unchecked="TranslateCheck_Changed"/>
                <Button Content="Çeviri Ayarları…" Click="TranslationSettings_Click"/>
                <Button x:Name="InstallOcrButton" Content="İngilizce OCR Paketini Kur" Click="InstallOcr_Click"
                        Visibility="Collapsed" FontWeight="Bold"/>
                <TextBlock x:Name="SelectHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FFB03B"
                           Visibility="Collapsed" Text="Önizlemede altyazı alanını fareyle çizin. Vazgeçmek için Esc."/>
            </WrapPanel>
        </Border>

        <!-- Satır 4: önizleme + durum -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="#3A3F47" BorderThickness="1">
                    <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality"/>
                        <TextBlock x:Name="PreviewPlaceholder" Foreground="#888" FontSize="18" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"
                                   Text="Yakalanan oyun görüntüsü burada gösterilecek.&#x0a;PS Remote Play'i açıp PS5'e bağlanın ya da 'Görüntü Dosyasıyla Test Et' ile bir PNG açın."/>
                        <Canvas x:Name="Overlay" Background="Transparent"
                                MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp">
                            <Canvas x:Name="LinesLayer" IsHitTestVisible="False"/>
                            <Rectangle x:Name="RegionRect" Stroke="#FFD400" StrokeThickness="2" StrokeDashArray="4 2"
                                       Fill="#22FFD400" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Rectangle x:Name="DragRect" Stroke="#00D4FF" StrokeThickness="2"
                                       Fill="#2200D4FF" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Altyazı alanı canlı görünümü -->
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#23262B" BorderBrush="#3A3F47" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="ALTYAZI ALANI (CANLI, BÜYÜTÜLMÜŞ)"/>
                            <Border Background="Black" Height="110" Margin="0,4,0,0">
                                <Image x:Name="RegionImage" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="METİN MASKESİ (3. AŞAMADA OCR'IN GÖRECEĞİ)"/>
                            <Border Background="Black" Height="110" Margin="0,4,0,0">
                                <Image x:Name="MaskImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="#23262B" BorderBrush="#3A3F47" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="REMOTE PLAY PENCERESİ" Margin="0"/>
                        <TextBlock x:Name="RemotePlayStatus" Style="{StaticResource Value}" Text="Kontrol ediliyor…"/>

                        <TextBlock Style="{StaticResource Label}" Text="YAKALAMA DURUMU"/>
                        <TextBlock x:Name="CaptureStatus" Style="{StaticResource Value}" Text="Durduruldu"/>

                        <TextBlock Style="{StaticResource Label}" Text="ALTYAZI ALGILAMA"/>
                        <TextBlock x:Name="PresenceText" Style="{StaticResource Value}" FontSize="20" FontWeight="Bold" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="TÜRKÇE ÇEVİRİ"/>
                        <TextBlock x:Name="TurkishText" Style="{StaticResource Value}" FontSize="20" FontWeight="Bold" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="ÇEVİRİ"/>
                        <TextBlock x:Name="TranslationStatusText" Style="{StaticResource Value}" FontSize="12" Text="Başlatılıyor…"/>

                        <TextBlock Style="{StaticResource Label}" Text="İNGİLİZCE METİN (YALNIZCA TEST EKRANI)"/>
                        <TextBlock x:Name="EnglishText" Style="{StaticResource Value}" FontSize="18" FontWeight="SemiBold" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="OCR"/>
                        <TextBlock x:Name="OcrStatusText" Style="{StaticResource Value}" FontSize="12" Text="Başlatılıyor…"/>

                        <TextBlock Style="{StaticResource Label}" Text="ALTYAZI ALANI"/>
                        <TextBlock x:Name="RegionText" Style="{StaticResource Value}" FontSize="12" Text="Seçilmedi"/>

                        <TextBlock Style="{StaticResource Label}" Text="GÖRÜNTÜ DURUMU"/>
                        <TextBlock x:Name="VerdictText" Style="{StaticResource Value}" FontWeight="Bold" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="OYUN ALANI / YÖNTEM"/>
                        <TextBlock x:Name="FrameSizeText" Style="{StaticResource Value}" FontSize="12" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="FPS / İŞLEME SÜRESİ"/>
                        <TextBlock x:Name="FpsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="PARLAKLIK / KONTRAST / HAREKET"/>
                        <TextBlock x:Name="LumaText" Style="{StaticResource Value}" FontSize="12" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="İSTATİSTİK (BU OTURUM)"/>
                        <TextBlock x:Name="StatsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>

                        <TextBlock Style="{StaticResource Label}" Text="DOĞRULAMA TESTİ"/>
                        <TextBlock x:Name="VerifyText" Style="{StaticResource Value}" FontSize="12"
                                   Text="Oyunda hareketli bir sahnedeyken '10 sn Doğrulama Testi'ne basın."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <ListBox x:Name="LogList" Grid.Row="4" Margin="0,10,0,0"
                 Background="#111316" Foreground="#D0D0D0" BorderBrush="#3A3F47"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
