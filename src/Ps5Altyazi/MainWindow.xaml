<Window x:Class="Ps5Altyazi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı+ – PS5 oyunları için canlı Türkçe altyazı"
        Icon="Resources/logo-256.png"
        Height="820" Width="1260" MinHeight="560" MinWidth="900"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Grid x:Name="MainGrid" Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Üst bant: logo · sekmeler · durum ═════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="HeaderLogo" Source="Resources/logo-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="Bold">
                        <Run Text="Altyazı"/><Run Text="+" Foreground="{StaticResource Cyan}"/>
                    </TextBlock>
                    <TextBlock x:Name="HeaderSub" Foreground="{StaticResource TextDim}" FontSize="11" Text="Yapımcı: Burak Topcu"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="NavBar" Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="22" Padding="3"
                    HorizontalAlignment="Center" Margin="16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavTab}" GroupName="nav" Content="Ana Ekran" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavTab}" GroupName="nav" Content="Geçmiş" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" GroupName="nav" Content="Ayarlar" Checked="Nav_Checked"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource Cyan}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CaptureStatus" Text="Hazır" FontSize="13" VerticalAlignment="Center"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Pencere düğmeleri (küçült / büyüt / kapat) – uygulamanın kendi üst bandında, sağ üst köşede -->
        <StackPanel x:Name="CaptionButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-14,-22,0"/>

        <!-- İlk kurulum: tamamlanana kadar sekmelerin yerine ana pencerede gösterilir -->
        <ContentControl x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed"/>

        <!-- ═════════════════════════ ANA EKRAN ═════════════════════════ -->
        <Grid x:Name="HomePage" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>
                    <!-- Önizleme -->
                    <Border CornerRadius="20" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource HeroBrush}"
                            MaxWidth="820" HorizontalAlignment="Stretch">
                        <Grid>
                            <Rectangle Fill="{StaticResource HeroGlow}" RadiusX="20" RadiusY="20"/>
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="PreviewHost" Width="1280" Height="720" SizeChanged="PreviewHost_SizeChanged" ClipToBounds="True">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Image Source="Resources/logo-256.png" Width="130" Height="130" Opacity="0.9" Margin="0,0,0,26"/>
                                        <Border Background="#CC0B0F1A" CornerRadius="16" Padding="26,12" HorizontalAlignment="Center">
                                            <TextBlock x:Name="PreviewPlaceholder" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"
                                                       Text="Oyun görüntüsü ve altyazı alanı burada görünecek."/>
                                        </Border>
                                    </StackPanel>
                                    <Canvas x:Name="Overlay" Background="Transparent"
                                            MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp">
                                        <Canvas x:Name="LinesLayer" IsHitTestVisible="False"/>
                                        <Rectangle x:Name="RegionRect" Stroke="{StaticResource Cyan}" StrokeThickness="3" StrokeDashArray="5 3"
                                                   Fill="{StaticResource AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False"
                                                   RadiusX="8" RadiusY="8"/>
                                        <Rectangle x:Name="DragRect" Stroke="{StaticResource Accent}" StrokeThickness="3"
                                                   Fill="#222F8BFF" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Büyük düğmeler -->
                    <Grid Margin="0,16,0,0" MaxWidth="820">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartStopButton" Grid.Column="0" Style="{StaticResource Primary}" Margin="0,0,10,0"
                                Content="▶   Çeviriyi Başlat" Click="StartStop_Click" ToolTip="F6"/>
                        <Button x:Name="AutoDetectButton" Grid.Column="1" Style="{StaticResource Big}" Margin="0,0,10,0"
                                Content="✦  Altyazıyı Bul" Click="AutoDetect_Click" ToolTip="Biri konuşurken basın: altyazının yerini kendisi bulur"/>
                        <Button Grid.Column="2" Style="{StaticResource Big}" Content="🧪  TV'de Dene" Click="TestSubtitle_Click"
                                ToolTip="TV'ye 'Bu bir test altyazısıdır' gönderir"/>
                    </Grid>

                    <!-- Altyazı alanı araçları -->
                    <WrapPanel Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Stretch">
                        <Button x:Name="SelectRegionButton" Content="▭ Alanı fareyle seç" Click="SelectRegion_Click"/>
                        <Button Content="✕ Alanı temizle" Click="ClearRegion_Click"/>
                        <TextBlock x:Name="RegionText" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Text="Altyazı alanı seçilmedi" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <Button x:Name="InstallOcrButton" Content="İngilizce OCR Paketini Kur" Click="InstallOcr_Click"
                                Visibility="Collapsed" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FFB03B"
                                   Visibility="Collapsed" Text="Önizlemede altyazı alanını fareyle çizin. Vazgeçmek için Esc."/>
                    </WrapPanel>

                    <!-- Canlı çeviri -->
                    <Border CornerRadius="20" Padding="22,16" Margin="0,14,0,0" Background="{StaticResource LiveCardBrush}" MaxWidth="820">
                        <StackPanel>
                            <TextBlock Text="CANLI ÇEVİRİ" FontSize="11" FontWeight="Bold" Foreground="#E6FFFFFF"/>
                            <TextBlock x:Name="TurkishText" Text="—" FontSize="21" FontWeight="Bold" Foreground="White"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="PresenceText" Text="—" FontSize="13" Foreground="#DDFFFFFF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ sütun: durum kutucukları -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Yeni sürüm kartı (yalnız güncelleme varken görünür) -->
                    <Border x:Name="UpdateCard" Visibility="Collapsed" CornerRadius="18" Padding="18,14" Margin="0,0,0,12"
                            Background="{StaticResource Card}" BorderBrush="#2FC76E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitle" Text="Yeni sürüm hazır" FontSize="15" FontWeight="Bold" Foreground="#6EE7A8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="UpdateSub" Text="" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <Button x:Name="UpdateButton" Click="Update_Click" FontWeight="Bold" HorizontalAlignment="Left"
                                    Background="#1F9D55" BorderBrush="#2FC76E" Foreground="White" Padding="18,8" Margin="0"
                                    Content="⬇  Şimdi güncelle"/>
                            <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"
                                         Foreground="#2FC76E" Background="{StaticResource Line}" BorderThickness="0"/>
                            <Expander Header="Neler değişti?" Margin="0,8,0,0">
                                <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,4,0,0"/>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Tile}" Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#3A2F6B">
                                    <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PS5" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                        <TextBlock x:Name="Ps5Dot" Text=" ●" Foreground="#FF5C5C" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Ps5PillText" Text="bağlı değil" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="0" Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#5A4316">
                                    <TextBlock Text="📺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TV" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                        <TextBlock x:Name="TvDot" Text=" ●" Foreground="#FF5C5C" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TvPillText" Text="bağlı değil" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="2" Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#1D4A44">
                                    <TextBlock Text="👁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Okuma" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock x:Name="VerdictText" Text="—" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}" Grid.Row="2" Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#1E3A66">
                                    <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Çeviri" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock x:Name="TranslatorTileText" Text="—" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Oyun -->
                    <Border Style="{StaticResource Tile}" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Değiştir" Click="PickGame_Click" VerticalAlignment="Center" ToolTip="Oyunu seç"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#4A2A55">
                                    <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="GameTileLabel" Text="Oyun" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <TextBlock x:Name="GameTileText" Text="Seçilmedi" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Ayrıntılı durum -->
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="PS5 BAĞLANTISI" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RemotePlayStatus" Style="{StaticResource Value}" Text="Kontrol ediliyor…"/>
                            <TextBlock Style="{StaticResource Label}" Text="OKUMA (OCR)"/>
                            <TextBlock x:Name="OcrStatusText" Style="{StaticResource Value}" FontSize="12" Text="Başlatılıyor…"/>
                            <TextBlock Style="{StaticResource Label}" Text="ÇEVİRİ"/>
                            <TextBlock x:Name="TranslationStatusText" Style="{StaticResource Value}" FontSize="12" Text="Başlatılıyor…"/>
                        </StackPanel>
                    </Border>

                    <!-- Hızlı anahtarlar -->
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="18,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="HIZLI AYARLAR" Margin="0,0,0,6"/>
                            <CheckBox x:Name="SubtitleWindowCheck" IsChecked="True" Content="Türkçe altyazı (F8)"
                                      Checked="SubtitleWindowCheck_Changed" Unchecked="SubtitleWindowCheck_Changed"/>
                            <CheckBox x:Name="OcrCheck" IsChecked="True" Content="Okuma" ToolTip="Altyazı alanındaki İngilizce yazıyı okur (OCR)"
                                      Checked="OcrCheck_Changed" Unchecked="OcrCheck_Changed"/>
                            <CheckBox x:Name="TranslateCheck" IsChecked="True" Content="Çeviri"
                                      Checked="TranslateCheck_Changed" Unchecked="TranslateCheck_Changed"/>
                            <CheckBox x:Name="TvServerCheck" Content="TV / telefon yayını"
                                      Checked="TvServerCheck_Changed" Unchecked="TvServerCheck_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═════════════════════════ GEÇMİŞ ═════════════════════════ -->
        <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Grid.Column="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Temizle" Click="ClearHistory_Click"/>
                        <TextBlock Text="Çeviri geçmişi" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="HistoryEmpty" DockPanel.Dock="Top" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                               Text="Çeviri başlayınca okunan her altyazı burada İngilizcesi ve Türkçesiyle listelenir."/>
                    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Grid.Column="2">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="⧉ Günlüğü kopyala" Click="CopyLog_Click"/>
                            <Button Content="📁 Klasör" Click="OpenFolder_Click"/>
                        </StackPanel>
                        <TextBlock Text="Günlük" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="LogList" Background="{StaticResource LogBg}" Foreground="{StaticResource LogText}"
                             BorderBrush="{StaticResource Line}" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═════════════════════════ AYARLAR ═════════════════════════ -->
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Grid.Column="0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="SetConn" Style="{StaticResource SideItem}" GroupName="set" IsChecked="True" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#3A2F6B"><TextBlock Text="🎮" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Bağlantı" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="PS5, kurulum" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SetSub" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#5A2F45"><TextBlock Text="Aa" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Altyazı Görünümü" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Yer, renk, yazı tipi" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SetTr" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#1E3A66"><TextBlock Text="🌐" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Çeviri" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Servisler, anahtarlar" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SetTv" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#5A4316"><TextBlock Text="📺" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="TV" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Kurulum, test" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="8,8"/>
                        <RadioButton x:Name="SetTheme" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#4A3570"><TextBlock Text="🎨" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Tema" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Renkler" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SetGeneral" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#33384A"><TextBlock Text="⚙" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Genel" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Başlangıç, güncelleme" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SetAdvanced" Style="{StaticResource SideItem}" GroupName="set" Checked="SettingsNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBox}" Background="#2B3A3A"><TextBlock Text="🛠" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Gelişmiş" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Teşhis, eski yöntem" Foreground="{StaticResource TextDim}" FontSize="12"/></StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Bağlantı -->
                    <StackPanel x:Name="PageConn">
                        <TextBlock Text="Bağlantı" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="PS5'e PS Remote Play uygulaması olmadan, arka planda bağlanılır." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="PS5" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="İkinci PSN hesabıyla giriş, PS5'i bulma ve 'Cihazı Bağla' koduyla eşleme. Bir kez yapılır."/>
                                <CheckBox x:Name="DirectCheck" Content="PS5'e doğrudan bağlan (PS Remote Play gerekmez)" Visibility="Collapsed" Margin="0,10,0,0"
                                          Checked="DirectCheck_Changed" Unchecked="DirectCheck_Changed"/>
                                <Button x:Name="Ps5ConnectButton" Style="{StaticResource LinkRow}" Click="Ps5Connect_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="🎮  PS5 Bağlantısını Düzenle"/></DockPanel>
                                </Button>
                                <Button Style="{StaticResource LinkRow}" Click="SetupWizard_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="🧭  Kurulum Adımlarını Aç"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Altyazı görünümü -->
                    <StackPanel x:Name="PageSub" Visibility="Collapsed">
                        <TextBlock Text="Altyazı Görünümü" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Çevirinin TV'deki yeri, renkleri, zemini ve yazı tipi." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Background="{StaticResource HeroBrush}" CornerRadius="14" Height="150" Margin="0,0,0,6">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource HeroGlow}" RadiusX="14" RadiusY="14"/>
                                        <Border Background="#E6000000" CornerRadius="10" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                                            <TextBlock Text="Ah, sen de mi? Bırakın beni rahat." FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Button Style="{StaticResource LinkRow}" Click="SubtitleAppearance_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="✎  Altyazı Görünümünü Düzenle"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Çeviri -->
                    <StackPanel x:Name="PageTr" Visibility="Collapsed">
                        <TextBlock Text="Çeviri" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Servisler sırayla denenir: DeepL → Gemini → Azure → MyMemory." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Hız ve kalite" FontSize="17" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="22" Padding="3" Margin="0,8,0,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeFast" Style="{StaticResource NavTab}" GroupName="trmode" Content="Hızlı" Checked="TrMode_Checked"/>
                                        <RadioButton x:Name="ModeBalanced" Style="{StaticResource NavTab}" GroupName="trmode" Content="Dengeli" Checked="TrMode_Checked"/>
                                        <RadioButton x:Name="ModeNatural" Style="{StaticResource NavTab}" GroupName="trmode" Content="En doğal" Checked="TrMode_Checked"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TrModeHint" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,16" Text=""/>
                                <TextBlock Text="Etkin servisler" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TranslationSummaryText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" Text="—"/>
                                <Button Style="{StaticResource LinkRow}" Click="TranslationSettings_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="🌐  Çeviri Servislerini Düzenle"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TV -->
                    <StackPanel x:Name="PageTv" Visibility="Collapsed">
                        <TextBlock Text="TV" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Türkçe altyazı TV'deki Altyazı+ uygulamasında, oyun görüntüsünün üstünde görünür." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="TV uygulaması" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="LG'de program uygulamayı kendisi kurar ve açar. Samsung ve Android TV için adımlar TV Kurulumu penceresinde."/>
                                <Button Style="{StaticResource LinkRow}" Click="TvMode_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="📺  TV Kurulumu"/></DockPanel>
                                </Button>
                                <Button Style="{StaticResource LinkRow}" Click="TestSubtitle_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="🧪  TV'ye test altyazısı gönder"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tema -->
                    <StackPanel x:Name="PageTheme" Visibility="Collapsed">
                        <TextBlock Text="Tema" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Arayüzün renkleri." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock x:Name="ThemeNameText" Text="—" FontSize="17" FontWeight="SemiBold"/>
                                <Button Style="{StaticResource LinkRow}" Click="ThemeSettings_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="🎨  Temayı Değiştir"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Genel -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <TextBlock Text="Genel" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Başlangıç, okuma hızı, PC ekranında altyazı, güncelleme." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Button Style="{StaticResource LinkRow}" Margin="0" Click="GeneralSettings_Click">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="→"/><TextBlock Text="⚙  Genel Ayarları Aç"/></DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Gelişmiş -->
                    <StackPanel x:Name="PageAdvanced" Visibility="Collapsed">
                        <TextBlock Text="Gelişmiş" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Teşhis araçları ve eski yöntem (PS Remote Play penceresinden okuma)." Foreground="{StaticResource TextDim}" Margin="0,2,0,14"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Eski yöntem: pencereden okuma" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,6" FontSize="12"
                                           Text="Yalnız 'PS5'e doğrudan bağlan' kapalıyken kullanılır."/>
                                <WrapPanel x:Name="WindowSourcePanel">
                                    <ComboBox x:Name="WindowCombo" Width="340"/>
                                    <Button Content="⟳ Yenile" Click="Refresh_Click"/>
                                    <Button Content="🔍 Remote Play'i Bul" Click="FindRemotePlay_Click"/>
                                    <Button x:Name="LaunchRemotePlayButton" Content="▶ PS Remote Play'i Aç" Click="LaunchRemotePlay_Click"/>
                                </WrapPanel>
                                <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="YAKALAMA"/>
                                    <ComboBox x:Name="MethodCombo" Width="250" SelectedIndex="0" SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="Windows Graphics Capture (önerilen)"/>
                                        <ComboBoxItem Content="PrintWindow (yedek / teşhis)"/>
                                    </ComboBox>
                                    <TextBlock Text="FPS" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                    <ComboBox x:Name="FpsCombo" Width="60" SelectedIndex="2" SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="30"/>
                                        <ComboBoxItem Content="60"/>
                                    </ComboBox>
                                    <CheckBox x:Name="CropCheck" IsChecked="True" Content="Başlık çubuğunu ve siyah bantları kırp"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </WrapPanel>
                                <WrapPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="ARAÇLAR"/>
                                    <Button x:Name="VerifyButton" Content="✔ 10 sn Doğrulama Testi" Click="Verify_Click"/>
                                    <Button Content="Kare Kaydet (F9)" Click="SavePng_Click"/>
                                    <Button Content="Görüntü Dosyasıyla Test Et…" Click="TestImage_Click"/>
                                    <Button Content="📁 Log / Görüntü Klasörü" Click="OpenFolder_Click"/>
                                </WrapPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="ALTYAZI ALANI (CANLI)"/>
                                        <Border Background="Black" Height="90" Margin="0,4,0,0" CornerRadius="8">
                                            <Image x:Name="RegionImage" Stretch="Uniform"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="METİN MASKESİ (OCR'IN GÖRDÜĞÜ)"/>
                                        <Border Background="Black" Height="90" Margin="0,4,0,0" CornerRadius="8">
                                            <Image x:Name="MaskImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label}" Text="İNGİLİZCE METİN"/>
                                <TextBlock x:Name="EnglishText" Style="{StaticResource Value}" FontSize="13" Text="—"/>
                                <TextBlock Style="{StaticResource Label}" Text="OYUN ALANI / YÖNTEM"/>
                                <TextBlock x:Name="FrameSizeText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                <TextBlock Style="{StaticResource Label}" Text="FPS / İŞLEME SÜRESİ"/>
                                <TextBlock x:Name="FpsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                <TextBlock Style="{StaticResource Label}" Text="PARLAKLIK / KONTRAST / HAREKET"/>
                                <TextBlock x:Name="LumaText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                <TextBlock Style="{StaticResource Label}" Text="İSTATİSTİK (BU OTURUM)"/>
                                <TextBlock x:Name="StatsText" Style="{StaticResource Value}" FontSize="12" Text="—"/>
                                <TextBlock Style="{StaticResource Label}" Text="DOĞRULAMA TESTİ"/>
                                <TextBlock x:Name="VerifyText" Style="{StaticResource Value}" FontSize="12"
                                           Text="Oyunda hareketli bir sahnedeyken '10 sn Doğrulama Testi'ne basın."/>
                                <!-- Oyun içi yazı çevirisi şimdilik rafta (kod duruyor, arayüzde gizli) -->
                                <CheckBox x:Name="ScreenCheck" Visibility="Collapsed" Checked="ScreenCheck_Changed" Unchecked="ScreenCheck_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
