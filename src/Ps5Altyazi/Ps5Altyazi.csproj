<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Windows Graphics Capture API'leri için Windows SDK projeksiyonu -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Çalışma için en düşük sürüm: Windows 10 2004 (19041) -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AltyaziPlus</AssemblyName>
    <RootNamespace>Ps5Altyazi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.14.0</Version>
    <Product>Altyazı+</Product>
    <Authors>Burak Topcu</Authors>
    <Company>Burak Topcu</Company>
    <Copyright>© 2026 Burak Topcu</Copyright>
    <Description>Altyazı+ – PS5 oyunları için canlı Türkçe çeviri</Description>
    <Description>Aşama 8 – TV modu (LG webOS)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\logo-256.png" />
    <!-- Çeviri önbelleği (SQLite) ve API anahtarının Windows DPAPI ile şifrelenmesi -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- LG webOS TV'ye uygulama kurmak için (geliştirici modu SSH, port 9922) -->
    <PackageReference Include="SSH.NET" Version="2024.1.0" />
    <!-- PSN girişi: Sony'nin kendi giriş sayfası program içinde açılır (şifre programa gelmez) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <!-- PS5 bağlantı yardımcısı (ayrı program; tools/ps5-baglanti). CI'da (build.yml, "ps5-baglanti" işi) derlenip
       native\ klasörüne konur ve programın içine gömülür; ilk kullanımda %LOCALAPPDATA%\PS5TurkceAltyazi\bin'e çıkarılır. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)native\ps5-baglanti.exe')">
    <EmbeddedResource Include="native\ps5-baglanti.exe" LogicalName="ps5-baglanti.exe" />
  </ItemGroup>

  <ItemGroup>
    <!-- TV uygulamaları programın içine gömülür; kullanıcı ayrı dosya indirmez -->
    <EmbeddedResource Include="..\..\tv\tr.ps5altyazi.tv_1.0.12_all.ipk" LogicalName="tvapp.webos.ipk" />
    <EmbeddedResource Include="Resources\en_words.txt.gz" LogicalName="en_words.txt.gz" />
    <!-- Tema şablonu: açılışta seçilen temanın renkleriyle yüklenir (ThemePalettes.cs); derlenmiş sayfa değil -->
    <Page Remove="Resources\Theme.template.xaml" />
    <EmbeddedResource Include="Resources\Theme.template.xaml" LogicalName="theme.template.xaml" />
    <!-- Oyunun altyazısına benzetilen yazı tipleri (açık lisanslı, Türkçe karakterli) -->
    <EmbeddedResource Include="Resources\Fonts\*.ttf" LogicalName="fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Fonts\catalog.json" LogicalName="fonts/catalog.json" />
  </ItemGroup>

</Project>
